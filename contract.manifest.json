{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "cascades-public-developer-contract",
  "manifest_version": 1,
  "policy": "deny-by-default",
  "legal_authority": "LICENSE",
  "human_contract": "CONTRACT.md",
  "public_api": {
    "canonical_mirror": "api/openapi.yaml",
    "compatibility_mirror": "contracts/api.yaml",
    "version_source": "openapi.info.version"
  },
  "required_artifacts": [
    {"path": "LICENSE", "type": "file"},
    {"path": "CONTRACT.md", "type": "file"},
    {"path": "README.md", "type": "file"},
    {"path": "SECURITY.md", "type": "file"},
    {"path": "api/openapi.yaml", "type": "file"},
    {"path": "contracts/api.yaml", "type": "file"},
    {"path": "schemas", "type": "directory"},
    {"path": "docs", "type": "directory"},
    {"path": "examples", "type": "directory"},
    {"path": "src/cascades_sdk", "type": "directory"},
    {"path": "packages/cascades-sdk", "type": "directory"},
    {"path": "packages/mcp-server", "type": "directory"},
    {"path": "packages/vscode-extension", "type": "directory"},
    {"path": "cli", "type": "directory"}
  ],
  "public_roots": [
    "api",
    "cli",
    "contracts",
    "docs",
    "examples",
    "packages",
    "schemas",
    "sdk",
    "src"
  ],
  "repository_infrastructure_roots": [
    ".github",
    "scripts",
    "tests"
  ],
  "private_roots_forbidden": [
    "scheduler",
    "worker",
    "worker-controller",
    "executor",
    "queue",
    "persistence",
    "repository",
    "webserver",
    "control-plane",
    "deploy",
    "infrastructure"
  ],
  "versioning": {
    "patch": "compatible clarification or documentation",
    "minor": "additive public capability",
    "major": "intentional incompatible public contract change"
  },
  "rules": [
    "Top-level directories are denied unless explicitly declared as a public root or repository infrastructure root.",
    "Only explicitly declared public artifacts are supported integration surfaces.",
    "Undocumented endpoints, generated artifacts, fixtures, incidental symbols, and private implementation details are not promoted into the public contract by presence alone.",
    "Private implementation roots must not be copied into this SDK repository.",
    "The two OpenAPI mirrors must remain byte-for-byte identical."
  ]
}
